# Copy this file to .env and fill in your values:
#   copy .env.example .env

# --- Required: Groq (LLM answers) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024

# --- Required: FastAPI auth (header X-API-Key) ---
RAG_API_KEY=change-me-to-a-long-random-secret
# (alias also accepted: API_KEY=...)

# --- Required: PostgreSQL + pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Or set a full URL instead of POSTGRES_* :
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/rag_db

# --- Optional: Redis query cache ---
RAG_REDIS_HOST=localhost
RAG_REDIS_PORT=6379
